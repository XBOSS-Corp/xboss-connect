{
  "name": "Cancel Korean tax invoices in full with XBOSS",
  "nodes": [
    {
      "id": "96052a8b-db9b-5ba6-8d89-ce339519bdb8",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "dd226b63-4ebb-5edd-8a64-0bcd91158870",
      "name": "Task inputs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Edit task inputs. Secrets belong in n8n credentials.\nreturn [{json:{\n  \"business_key\": \"\",\n  \"account_link_id\": \"\",\n  \"env_scope\": \"real_test\",\n  \"resume_job_id\": \"\",\n  \"reviewed\": false,\n  \"params\": {\n    \"confirm\": false,\n    \"etxiv_mdf_rsn_cd\": \"\",\n    \"old_aprv_no\": \"\",\n    \"supply_date\": \"\"\n  }\n}}];"
      }
    },
    {
      "id": "70c043f3-8479-5107-a423-abef23867918",
      "name": "Validate inputs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const c=$input.first().json;\nif (!['real_test','production'].includes(c.env_scope)) throw new Error('Choose real_test or production; neither is a simulation.');\nif (c.resume_job_id) {\n if (!/^job_[0-9A-HJKMNP-TV-Z]{26}$/.test(c.resume_job_id)) throw new Error('Invalid resume_job_id');\n return [{json:{...c,resume:true,job_id:c.resume_job_id}}];\n}\nif (!/^[A-Za-z0-9._:-]{1,90}$/.test(c.business_key||'')) throw new Error('Set a stable business_key. Reuse it for recovery of the SAME task.');\nif (c.reviewed!==true) throw new Error('Review inputs, then set reviewed=true.');\nif (!c.params || Array.isArray(c.params) || typeof c.params!=='object') throw new Error('params must be an object');\nfor (const key of [\"confirm\", \"etxiv_mdf_rsn_cd\", \"old_aprv_no\", \"supply_date\"]) if (c.params[key]===undefined || c.params[key]===null || c.params[key]==='') throw new Error('Required input: '+key);\nif (!c.account_link_id) throw new Error('Set the XBOSS institution account_link_id.'); if (c.params.confirm!==true) throw new Error('Obtain user consent for these exact inputs before setting confirm=true.');if (!['04','06'].includes(c.params.etxiv_mdf_rsn_cd)) throw new Error('Only full cancellation reasons 04 and 06 are supported.');\nreturn [{json:{...c,resume:false,idempotency_key:'n8n:invoice-cancel:'+c.business_key,body:{provider:\"hometax\",action:\"hometax.etax.invoice.modify\",params:c.params,...(c.account_link_id?{account_link_id:c.account_link_id}:{})}}}];"
      }
    },
    {
      "id": "d262f254-064a-5ab9-92fb-557c469b2233",
      "name": "Resume existing job",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cb7be0dd-dd7c-5e74-9553-cba12b54ac94",
              "leftValue": "={{ $json.resume }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "50599b12-961a-5770-8f5c-8c4a2660f19e",
