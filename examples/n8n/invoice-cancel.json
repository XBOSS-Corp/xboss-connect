        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Env-Scope",
              "value": "={{ $('Validate inputs').first().json.env_scope }}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{ $json.idempotency_key }}"
            }
          ]
        },
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "timeout": 120000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.body }}"
      },
      "retryOnFail": false
    },
    {
      "id": "0cbb4629-2d4d-50ff-a62d-09c48273a5f6",
      "name": "Keep job reference",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "const j=$input.first().json; if (!/^job_[0-9A-HJKMNP-TV-Z]{26}$/.test(j.job_id||'')) throw new Error('No valid job_id. Keep the business_key; check XBOSS jobs before recovery. Do not create a new key.'); return [{json:{job_id:j.job_id}}];"
      }
    },
    {
      "id": "3aef934f-3bfb-5e0c-a538-d5e34963e7e9",
      "name": "Read job status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "url": "={{ 'https://api.xdata.kr/v1/jobs/' + $('Keep job reference').first().json.job_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Env-Scope",
              "value": "={{ $('Validate inputs').first().json.env_scope }}"
            }
          ]
        },
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "timeout": 120000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
