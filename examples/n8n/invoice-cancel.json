    },
    {
      "id": "94b95425-004a-5309-98e5-21a9d23bc4f1",
      "name": "Check job status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "jsCode": "const s=$input.first().json; const id=$('Keep job reference').first().json.job_id; if (s.job_id!==id) throw new Error('Mismatched job response'); if (['FAILED','TIMEOUT','CANCELED'].includes(s.status)) throw new Error('Job '+s.status+'. Check existing job '+id+'; do not resubmit automatically.'); if (!['SUCCEEDED','RUNNING','QUEUED'].includes(s.status)) throw new Error('Unknown job status'); if (s.status!=='SUCCEEDED' && $runIndex>=59) throw new Error('Polling limit reached. Resume job '+id+' with resume_job_id.'); return [{json:s}];"
      }
    },
    {
      "id": "6f0cab8c-8872-56bb-a1ff-67130039f011",
      "name": "Completed",
      "type": "n8n-nodes-base.if",
