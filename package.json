{
  "name": "xboss-connect",
  "version": "0.1.5",
  "description": "홈택스, 4대보험, 은행, 위택스 등 기관 업무를 AI와 코드로 연결하는 XBOSS 공식 API와 MCP 클라이언트",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "xboss-connect": "./bin/xboss.mjs"
  },
  "exports": {
    ".": "./src/client.mjs",
    "./catalog": "./src/catalog.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "catalog/",
    "docs/",
    "examples/",
    "skills/",
    "README.md",
    "README.en.md",
    "PRODUCTS.md",
    "LICENSE",
    "SECURITY.md",
    ".env.example",
    "plugin.json",
    "mcp.json",
    "gemini-extension.json",
    "GEMINI.md"
  ],
  "scripts": {
    "test": "node --test",
    "verify": "node scripts/verify-public.mjs",
    "catalog:sync": "node scripts/sync-catalog.mjs",
    "docs:generate": "node scripts/generate-docs.mjs",
    "check": "npm test && npm run verify",
    "verify:platforms": "node scripts/verify-platforms.mjs"
  }
}
